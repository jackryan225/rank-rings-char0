module

public import RankRings.ExoticS
public import RankRings.NoHom

@[expose] public section
/-!
# The main theorem: a countable regular rank `ℚ`-algebra that is not a rank-ultraproduct limit
-/

open Matrix Filter
open scoped LinearAlgebra.Projectivization

namespace RankRings

instance fact7 : Fact (Nat.Prime 7) := ⟨by norm_num⟩

/-- The points (and lines) of the projective plane over `ZMod 7`. -/
abbrev Pt := ℙ (ZMod 7) (Fin 3 → ZMod 7)

noncomputable instance : Fintype Pt := Fintype.ofFinite _

lemma order_Pt : Configuration.ProjectivePlane.order Pt Pt = 7 := order_ofField 7

/-- von Neumann regular rings. -/
def IsVNRegular (S : Type*) [Ring S] : Prop := ∀ a : S, ∃ b, a * b * a = a

/-- Rank functions on a ring. -/
structure IsRankFunction {S : Type*} [Ring S] (rk : S → ℝ) : Prop where
  nonneg : ∀ x, 0 ≤ rk x
  le_one : ∀ x, rk x ≤ 1
  map_one : rk 1 = 1
  eq_zero_iff : ∀ x, rk x = 0 ↔ x = 0
  add_le : ∀ x y, rk (x + y) ≤ rk x + rk y
  mul_le_left : ∀ x y, rk (x * y) ≤ rk x
  mul_le_right : ∀ x y, rk (x * y) ≤ rk y
  add_orth : ∀ e f, e * e = e → f * f = f → e * f = 0 → f * e = 0 → rk (e + f) = rk e + rk f

/-- The hyperfilter on `ℕ`. -/
noncomputable abbrev hyp : Ultrafilter ℕ := Filter.hyperfilter ℕ

lemma hyp_ge (j : ℕ) : ∀ᶠ k in (hyp : Filter ℕ), j ≤ k :=
  Filter.hyperfilter_le_cofinite (Nat.cofinite_eq_atTop ▸ Filter.eventually_ge_atTop j)

section rankAlgebra

variable (K : Type) [NormedField K] [IsUltrametricDist K]

lemma isVNRegular_RR : IsVNRegular (RR K WI hyp) := fun a => rr_regular hyp_ge a

lemma isRankFunction_RR : IsRankFunction (rk K WI hyp) where
  nonneg := rk_nonneg
  le_one := rk_le_one
  map_one := rk_one
  eq_zero_iff := rk_eq_zero_iff
  add_le := rk_add_le
  mul_le_left := rk_mul_le_left
  mul_le_right := rk_mul_le_right
  add_orth _ _ he hf hef hfe := rk_add_orth he hf hef hfe

end rankAlgebra

/-! ### No configuration in a ring with a hom to a rank ultraproduct -/

/-- The relations of `B_7`. -/
structure Config (R : Type*) [Ring R] (σ : Pt ≃ Pt) where
  f : Pt → R
  g : Pt → Pt → R
  x : Pt → Pt → Fin 3 → R
  y : Pt → Pt → Fin 3 → R
  h1 : ∀ p, f p * f p = f p
  h2 : ∀ p p', p ∈ σ p' → f p * g p p' = g p p'
  h3 : ∀ p p', p ∈ σ p' → f p' * g p p' = 0
  h4 : ∀ p p', p ∈ σ p' → ∑ i, y p p' i * g p p' * x p p' i = 1

/-- Ring homomorphisms carry configurations. -/
def Config.map {R R' : Type*} [Ring R] [Ring R'] {σ : Pt ≃ Pt} (c : Config R σ) (φ : R →+* R') :
    Config R' σ where
  f p := φ (c.f p)
  g p p' := φ (c.g p p')
  x p p' i := φ (c.x p p' i)
  y p p' i := φ (c.y p p' i)
  h1 p := by rw [← map_mul, c.h1]
  h2 p p' h := by rw [← map_mul, c.h2 p p' h]
  h3 p p' h := by rw [← map_mul, c.h3 p p' h, map_zero]
  h4 p p' h := by
    simp only [← map_mul, ← map_sum, c.h4 p p' h, map_one]

theorem no_config_RU {σ : Pt ≃ Pt} {I : Type} (ω : Ultrafilter I) (d : I → ℕ) (hd : ∀ i, 0 < d i)
    (c : Config (RU ω d) σ) : False :=
  no_config σ (by rw [order_Pt]) hd c.f c.g c.x c.y c.h1 c.h2 c.h3 c.h4

/-- The exotic configuration in the rank algebra over an extension of `ℚ_[7]`. -/
noncomputable def configRR (K : Type) [NormedField K] [IsUltrametricDist K] [NormedAlgebra ℚ_[7] K]
    (σ : Pt ≃ Pt) (hσ : ∀ p, p ∉ σ p) : Config (RR K WI hyp) σ :=
  let h := exotic_RR 7 K hyp hyp_ge σ hσ
  { f := h.choose
    g := h.choose_spec.choose
    x := h.choose_spec.choose_spec.choose
    y := h.choose_spec.choose_spec.choose_spec.choose
    h1 := h.choose_spec.choose_spec.choose_spec.choose_spec.1
    h2 := h.choose_spec.choose_spec.choose_spec.choose_spec.2.1
    h3 := h.choose_spec.choose_spec.choose_spec.choose_spec.2.2.1
    h4 := h.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2 }

lemma exists_sigma_Pt : ∃ σ : Pt ≃ Pt, ∀ p, p ∉ σ p := exists_sigma

/-! ### A countable regular subalgebra -/

/-- Generators. -/
abbrev Gens := Pt ⊕ (Pt × Pt) ⊕ (Pt × Pt × Fin 3) ⊕ (Pt × Pt × Fin 3)

/-- Terms. -/
inductive Tm : Type
  | gen : Gens → Tm
  | rat : ℚ → Tm
  | add : Tm → Tm → Tm
  | mul : Tm → Tm → Tm
  | qi : Tm → Tm
  deriving Countable

section closure

variable {R : Type*} [Ring R] (ι : ℚ →+* R) (qi : R → R) (gen : Gens → R)

/-- Evaluation of terms. -/
def Tm.eval : Tm → R
  | .gen a => gen a
  | .rat q => ι q
  | .add a b => a.eval + b.eval
  | .mul a b => a.eval * b.eval
  | .qi a => qi a.eval

/-- The countable subring generated by `gen` and `ι ℚ`, closed under `qi`. -/
def clos : Subring R where
  carrier := Set.range (Tm.eval ι qi gen)
  mul_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨Tm.mul a b, rfl⟩
  add_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨Tm.add a b, rfl⟩
  one_mem' := ⟨Tm.rat 1, map_one ι⟩
  zero_mem' := ⟨Tm.rat 0, map_zero ι⟩
  neg_mem' := by
    rintro _ ⟨a, rfl⟩
    exact ⟨Tm.mul (Tm.rat (-1)) a, by simp [Tm.eval]⟩

lemma clos_countable : Countable (clos ι qi gen) := by
  have : (Set.range (Tm.eval ι qi gen)).Countable := Set.countable_range _
  exact this.to_subtype

lemma gen_mem (a : Gens) : gen a ∈ clos ι qi gen := ⟨Tm.gen a, rfl⟩

lemma qi_mem {x : R} (hx : x ∈ clos ι qi gen) : qi x ∈ clos ι qi gen := by
  obtain ⟨a, rfl⟩ := hx
  exact ⟨Tm.qi a, rfl⟩

lemma rat_mem (q : ℚ) : ι q ∈ clos ι qi gen := ⟨Tm.rat q, rfl⟩

/-- The `ℚ`-algebra structure of the closure, for central `ι`. -/
@[instance_reducible]
def closAlgebra (hι : ∀ q x, ι q * x = x * ι q) : Algebra ℚ (clos ι qi gen) :=
  RingHom.toAlgebra' ((ι.codRestrict (clos ι qi gen) (rat_mem ι qi gen)))
    (fun q x => Subtype.ext (hι q x))

end closure

/-- A configuration in `R` lifts to the subring generated by it. -/
def Config.restrict {R : Type*} [Ring R] {σ : Pt ≃ Pt} (c : Config R σ) (ι : ℚ →+* R)
    (qi : R → R) :
    Config (clos ι qi (fun a : Gens => Sum.elim c.f (Sum.elim (fun pp => c.g pp.1 pp.2)
      (Sum.elim (fun t => c.x t.1 t.2.1 t.2.2) (fun t => c.y t.1 t.2.1 t.2.2))) a)) σ where
  f p := ⟨c.f p, gen_mem _ _ _ (Sum.inl p)⟩
  g p p' := ⟨c.g p p', gen_mem _ _ _ (Sum.inr (Sum.inl (p, p')))⟩
  x p p' i := ⟨c.x p p' i, gen_mem _ _ _ (Sum.inr (Sum.inr (Sum.inl (p, p', i))))⟩
  y p p' i := ⟨c.y p p' i, gen_mem _ _ _ (Sum.inr (Sum.inr (Sum.inr (p, p', i))))⟩
  h1 p := Subtype.ext (c.h1 p)
  h2 p p' h := Subtype.ext (c.h2 p p' h)
  h3 p p' h := Subtype.ext (c.h3 p p' h)
  h4 p p' h := by
    apply Subtype.ext
    simp only [AddSubmonoidClass.coe_finsetSum, Subring.coe_mul, Subring.coe_one]
    exact c.h4 p p' h

/-- The scalars `ℚ → RR`. -/
noncomputable def ratRR (K : Type) [NormedField K] [IsUltrametricDist K] [CharZero K] :
    ℚ →+* RR K WI hyp :=
  (RingCon.mk' _).comp ((algebraMap K (tight K WI hyp)).comp (algebraMap ℚ K))

lemma scalar_central (K : Type) [NormedField K] [IsUltrametricDist K] (c : K)
    (x : RR K WI hyp) : RingCon.mk' _ (algebraMap K (tight K WI hyp) c) * x
      = x * RingCon.mk' _ (algebraMap K (tight K WI hyp) c) := by
  obtain ⟨A, rfl⟩ := exists_rep x
  simp only [RingCon.coe_mk']
  rw [← RingCon.coe_mul, ← RingCon.coe_mul, Algebra.commutes]

lemma ratRR_central (K : Type) [NormedField K] [IsUltrametricDist K] [CharZero K] (q : ℚ)
    (x : RR K WI hyp) : ratRR K q * x = x * ratRR K q :=
  scalar_central K _ x

/-! ### The main theorem -/

/-- The core: a countable regular `ℚ`-algebra with a rank function and a configuration. -/
theorem main_core : ∃ σ : Pt ≃ Pt, ∃ (S : Type) (_ : Ring S) (_ : Algebra ℚ S), Countable S ∧
    IsVNRegular S ∧ (∃ rk : S → ℝ, IsRankFunction rk) ∧ Nonempty (Config S σ) := by
  obtain ⟨σ, hσ⟩ := exists_sigma_Pt
  let R := RR ℚ_[7] WI hyp
  let c := configRR ℚ_[7] σ hσ
  let qi : R → R := fun a => (isVNRegular_RR ℚ_[7] a).choose
  let gen : Gens → R := fun a => Sum.elim c.f (Sum.elim (fun pp => c.g pp.1 pp.2)
      (Sum.elim (fun t => c.x t.1 t.2.1 t.2.2) (fun t => c.y t.1 t.2.1 t.2.2))) a
  let S := clos (ratRR ℚ_[7]) qi gen
  refine ⟨σ, S, inferInstance, closAlgebra _ _ _ (ratRR_central ℚ_[7]), clos_countable _ _ _, ?_,
    ⟨fun x => rk ℚ_[7] WI hyp (x : R), ?_⟩, ⟨c.restrict (ratRR ℚ_[7]) qi⟩⟩
  · intro a
    refine ⟨⟨qi a, qi_mem _ _ _ a.2⟩, Subtype.ext ?_⟩
    exact (isVNRegular_RR ℚ_[7] (a : R)).choose_spec
  · have h := isRankFunction_RR ℚ_[7]
    exact
      { nonneg := fun x => h.nonneg x
        le_one := fun x => h.le_one x
        map_one := h.map_one
        eq_zero_iff := fun x => by
          rw [h.eq_zero_iff]
          exact ⟨fun hx => Subtype.ext hx, fun hx => by rw [hx]; rfl⟩
        add_le := fun x y => h.add_le x y
        mul_le_left := fun x y => h.mul_le_left x y
        mul_le_right := fun x y => h.mul_le_right x y
        add_orth := fun e f he hf hef hfe => h.add_orth e f (congrArg Subtype.val he)
          (congrArg Subtype.val hf) (congrArg Subtype.val hef) (congrArg Subtype.val hfe) }

/-- **Main theorem** (countable form, complex matrices). -/
theorem main_countable : ∃ (S : Type) (_ : Ring S) (_ : Algebra ℚ S), Countable S ∧ IsVNRegular S ∧
    ∃ rk : S → ℝ, IsRankFunction rk ∧
      ∀ (I : Type) (ω : Ultrafilter I) (d : I → ℕ), (∀ i, 0 < d i) → IsEmpty (S →+* RU ω d) := by
  obtain ⟨σ, S, instR, instA, h1, h2, ⟨rk, h3⟩, ⟨c⟩⟩ := main_core
  exact ⟨S, instR, instA, h1, h2, rk, h3, fun I ω d hd => ⟨fun φ => no_config_RU ω d hd (c.map φ)⟩⟩

end RankRings

end
