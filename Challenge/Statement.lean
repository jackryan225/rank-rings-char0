import Mathlib

/-!
# Rank rings of characteristic zero that are not limits of matrix rings: the statements

Mathlib only. Every notion used in the statements is defined in this file.

* `IsVNRegular S`: every `a` has a quasi-inverse `b` with `a * b * a = a`.
* `IsRankFunction rk`: a rank function in the sense of Elek (Goodearl's pseudo-rank function, faithful):
  values in `[0, 1]`, `rk 1 = 1`, `rk x = 0 ↔ x = 0`, `rk (x + y) ≤ rk x + rk y`,
  `rk (x * y) ≤ min (rk x) (rk y)`, `rk (e + f) = rk e + rk f` for orthogonal idempotents.
* `RankUltraproduct ω d F`: the rank ultraproduct `∏ᵢ M_{d i}(F i) / {a | rank (a i) / d i → 0 along ω}`
  (the quotient by the ring congruence generated by this relation).

`elek_countable` answers the question of Elek (arXiv:1006.5378, Section 1.2) in the reading
"countable regular rank `ℚ`-algebra", negatively, for targets over fields of characteristic zero:
a countable von Neumann regular `ℚ`-algebra with a rank function that has no unital
ring homomorphism into any rank ultraproduct of matrix rings over fields of characteristic zero, in
particular over `ℂ`. (Without "`ℚ`-algebra" this reading is trivial: the field with two elements has no
unital map into these targets.) Not answered here: the reading "`ℂ`-algebra of countable dimension over
`ℂ`", `*`-regular rings with `*`-embeddings, and targets over fields of positive characteristic.
`elek_complex` gives such an algebra over `ℂ` (no claim that its dimension over `ℂ` is countable).
`finite_form` is the finitary version:
a finite set of noncommutative integer polynomial relations that holds exactly in such a rank algebra, while
no complex `N × N` matrices satisfy all relations up to matrices of rank at most `ε N`.
-/

namespace RankRingsChallenge

/-- von Neumann regular rings. -/
def IsVNRegular (S : Type*) [Ring S] : Prop := ∀ a : S, ∃ b : S, a * b * a = a

/-- Rank functions on a ring. -/
structure IsRankFunction {S : Type*} [Ring S] (rk : S → ℝ) : Prop where
  nonneg : ∀ x, 0 ≤ rk x
  le_one : ∀ x, rk x ≤ 1
  map_one : rk 1 = 1
  eq_zero_iff : ∀ x, rk x = 0 ↔ x = 0
  add_le : ∀ x y, rk (x + y) ≤ rk x + rk y
  mul_le_left : ∀ x y, rk (x * y) ≤ rk x
  mul_le_right : ∀ x y, rk (x * y) ≤ rk y
  add_orth : ∀ e f, e * e = e → f * f = f → e * f = 0 → f * e = 0 → rk (e + f) = rk e + rk f

/-- The normalized rank of `a i` tends to zero along `ω`. -/
def IsRankNull {I : Type} (ω : Ultrafilter I) (d : I → ℕ) (F : I → Type) [∀ i, Field (F i)]
    (a : ∀ i, Matrix (Fin (d i)) (Fin (d i)) (F i)) : Prop :=
  Filter.Tendsto (fun i => ((a i).rank : ℝ) / d i) (ω : Filter I) (nhds 0)

/-- The rank ultraproduct of the matrix rings `M_{d i}(F i)` along `ω`. -/
abbrev RankUltraproduct {I : Type} (ω : Ultrafilter I) (d : I → ℕ) (F : I → Type)
    [∀ i, Field (F i)] : Type :=
  (ringConGen fun a b : (∀ i, Matrix (Fin (d i)) (Fin (d i)) (F i)) => IsRankNull ω d F (a - b)).Quotient

/-- **Elek's question, countable form.** -/
theorem elek_countable : ∃ (S : Type) (_ : Ring S) (_ : Algebra ℚ S), Countable S ∧ IsVNRegular S ∧
    ∃ rk : S → ℝ, IsRankFunction rk ∧
      ∀ (I : Type) (ω : Ultrafilter I) (d : I → ℕ) (F : I → Type) [∀ i, Field (F i)]
        [∀ i, CharZero (F i)], (∀ i, 0 < d i) → IsEmpty (S →+* RankUltraproduct ω d F) := by
  sorry

/-- **Elek's question, a `ℂ`-algebra.** -/
theorem elek_complex : ∃ (S : Type) (_ : Ring S) (_ : Algebra ℂ S), IsVNRegular S ∧
    ∃ rk : S → ℝ, IsRankFunction rk ∧
      ∀ (I : Type) (ω : Ultrafilter I) (d : I → ℕ) (F : I → Type) [∀ i, Field (F i)]
        [∀ i, CharZero (F i)], (∀ i, 0 < d i) → IsEmpty (S →+* RankUltraproduct ω d F) := by
  sorry

/-- **Finite form.** Finitely many generators and integer relations that hold exactly in a countable
regular rank `ℚ`-algebra, while no complex `N × N` matrices satisfy them up to rank `ε N`. -/
theorem finite_form : ∃ (Gn Rl : Type) (_ : Fintype Gn) (_ : Fintype Rl)
    (rel : Rl → FreeAlgebra ℤ Gn) (ε : ℝ), 0 < ε ∧
    (∃ (S : Type) (_ : Ring S) (_ : Algebra ℚ S), Countable S ∧ IsVNRegular S ∧
      (∃ rk : S → ℝ, IsRankFunction rk) ∧ ∃ x : Gn → S, ∀ j, FreeAlgebra.lift ℤ x (rel j) = 0) ∧
    ∀ N : ℕ, 0 < N → ∀ A : Gn → Matrix (Fin N) (Fin N) ℂ,
      ∃ j, ε * N < ((FreeAlgebra.lift ℤ A (rel j)).rank : ℝ) := by
  sorry

end RankRingsChallenge
